{
  "expo": {
    "name": "Destiny AI",
    "slug": "destiny-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "destinyai",

    "icon": "./assets/icon.png",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07111F"
    },

    "android": {
      "package": "com.emmanuelebitarijames.destinyai",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07111F"
      },
      "permissions": [
        "android.permission.INTERNET"
      ]
    },

    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Destiny AI to access your photos."
        }
      ]
    ],

    "extra": {
      "supabaseUrl": "https://vihbsfrwnslnmheowkhy.supabase.co"
    }
  }
}
