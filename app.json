{
  "expo": {
    "name": "Destiny AI",
    "slug": "destiny-ai",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "destinyai",
    "icon": "./assets/destiny-ai-icon.png",
    "splash": {
      "image": "./assets/destiny-ai-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020816"
    },
    "android": {
      "package": "com.destinyai",
      "versionCode": 13,
      "allowBackup": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    }
  }
}
